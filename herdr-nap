need() { command -v "$1" >/dev/null || { echo "$(t need_missing "$1")" >&2; exit 1; }; }

# 以 herdr plugin 身分執行時 PATH 不一定有 herdr，但 herdr 會給 HERDR_BIN_PATH
HERDR_BIN=${HERDR_BIN_PATH:-herdr}
herdr() { command "$HERDR_BIN" "$@"; }

# 整份 ps 只拍一次快照，找直屬子 process、RSS、etime、散裝行程都從這份取。
# 需要當下狀態時（送出 /exit 或 resume 之後）由呼叫端明確 refresh。
PS_DUMP=""
refresh_ps_dump() { ps -axo pid=,ppid=,rss=,etime=,args= > "$PS_DUMP"; }

# 釘選字樣：忽略空行與 # 開頭的註解，輸出一行一個
exclude_patterns() {
  [ -f "$1" ] || return 0
  grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$1" || true
}
# 標題或 tab 標籤含任一字樣就算釘選。參數：patterns(換行分隔) title label
is_pinned() {
  local patterns=$1 title=$2 label=$3 pat
  [ -n "$patterns" ] || return 1
  while IFS= read -r pat; do
    [ -n "$pat" ] || continue
    case "$title" in *"$pat"*) return 0 ;; esac
    case "$label" in *"$pat"*) return 0 ;; esac
  done <<< "$patterns"
  return 1
}
# column -t 會把空欄位吞掉、後面的欄位往前擠，顯示前把空欄位補成 -
fill_empty_fields() { awk -F'\t' -v OFS='\t' '{ for (i = 1; i <= NF; i++) if ($i == "") $i = "-"; print }'; }

# 把 --list 輸出裡釘選的列變灰（只在輸出到終端時）。參數：pinned pane 清單（空白分隔）
dim_pinned_lines() {
  if [ -t 1 ] && [ -n "$1" ]; then
    awk -v p=" $1 " 'index(p, " " $3 " ") { print "\033[2m" $0 "\033[0m"; next } 1'
  else
    cat
  fi
}

pane_shell_pid() {
  herdr pane process-info --pane "$1" 2>/dev/null |
    jq -r '.result.process_info.shell_pid // empty'
}

# pane 的 agent 本體是 pane shell 的直屬子 process（前景 process 在 agent
# 跑工具時會是孫層子 process，抓前景會拿錯 PID 與 RSS）。
# 輸出 "pid rss etime args..."，沒有就沒有輸出。
agent_row_of_pane() {
  local shell_pid
  shell_pid=$(pane_shell_pid "$1")
  [ -n "$shell_pid" ] || return 0
  awk -v s="$shell_pid" -v k="$2" '
    $2 == s { a = $5; sub(/^.*\//, "", a); if (a == k) { print; exit } }
  ' "$PS_DUMP" | awk '{ $2 = ""; print }'
}

agent_pid_of_pane() { agent_row_of_pane "$1" "$2" | awk '{print $1}'; }

# pid 的祖先鏈裡有沒有 herdr server（argv0 basename 為 herdr）。有就代表這個
# process 其實在某個 herdr pane 裡（pane shell 是 herdr server 的直屬子行程），
# 只是 herdr 還沒把它辨識成 agent（例如 stub resume 後卡在信任確認、或偵測延遲）。
# 這種不能當「herdr 之外直開」來 SIGTERM。
inside_herdr_tree() {
  local pid=$1 depth=0 line a
  while [ "${pid:-0}" -gt 1 ] && [ "$depth" -lt 20 ]; do
    line=$(awk -v x="$pid" '$1 == x { print; exit }' "$PS_DUMP")
    [ -n "$line" ] || return 1
    a=$(printf '%s' "$line" | awk '{ print $5 }'); a=${a##*/}
    [ "$a" = herdr ] && return 0
    pid=$(printf '%s' "$line" | awk '{ print $2 }')
    depth=$((depth + 1))
  done
  return 1
}

# 整棵 process 樹（root 加上所有子孫）的 RSS 合計與子孫數，輸出 "total_kb desc_count"。
# agent 本體的 RSS 不含 MCP server 與工具起的子行程，只看本體會低估。
tree_rss_of_pid() {
  awk -v root="$1" '
    { pid[NR] = $1; ppid[NR] = $2; rss[NR] = $3 }
    END {
      inset[root] = 1; total = 0; cnt = 0; changed = 1
      while (changed) {
        changed = 0
        for (i = 1; i <= NR; i++)
          if (!(pid[i] in inset) && (ppid[i] in inset)) {
            inset[pid[i]] = 1; total += rss[i]; cnt++; changed = 1
          }
      }
      for (i = 1; i <= NR; i++) if (pid[i] == root) total += rss[i]
      print total, cnt
    }' "$PS_DUMP"
}

# 對話紀錄檔最後一筆的 timestamp 轉 epoch。不用檔案 mtime：Claude Code 會回頭
# 改寫閒置 session 的 jsonl（實測最後訊息 9/15 的檔案 mtime 是 9/18），mtime
# 只能反映檔案被碰過，反映不了對話。claude 的 timestamp 是 ISO 8601 UTC，
# grok 的是 epoch 秒；尾端可能有幾行沒 timestamp 的帳目列，所以多看幾行取最大。
ACTIVITY_TAIL_LINES=50
last_entry_epoch() {
  local ts
  [ -f "$1" ] || return 0
  ts=$(tail -n "$ACTIVITY_TAIL_LINES" "$1" |
    jq -r 'select(type == "object" and .timestamp != null) | .timestamp' 2>/dev/null |
    sort | tail -1)
  case "$ts" in
    "") return 0 ;;
    *T*)
      # macOS 的 date -j；Linux 的 GNU date 走 -d
      TZ=UTC date -j -f '%Y-%m-%dT%H:%M:%S' "${ts%%.*}" +%s 2>/dev/null ||
        TZ=UTC date -d "${ts%%.*}" +%s 2>/dev/null || return 0 ;;
    *)
      # 數字型：可能帶小數、可能是毫秒或微秒，砍到 10 位秒數
      ts=${ts%%.*}
      while [ "${#ts}" -gt 10 ]; do ts=${ts%???}; done
      case "$ts" in *[!0-9]*|"") return 0 ;; esac
      printf '%s' "$ts" ;;
  esac
}

# 一組紀錄檔裡最新的最後一筆時間（epoch）；沒有任何檔案就輸出空字串。
# 檔名從 stdin 一行一個讀，路徑含空白也不會被切開
epoch_of_file_list() {
  local f e best=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    e=$(last_entry_epoch "$f")
    [ -n "$e" ] || continue
    if [ -z "$best" ] || [ "$e" -gt "$best" ]; then best=$e; fi
  done
  printf '%s' "$best"
}
latest_entry_epoch() { printf '%s\n' "$@" | epoch_of_file_list; }

# session 對話紀錄檔。用 session id 直接 glob，不必知道各家對 cwd 的編碼規則
# （claude 把 / 換成 -，grok 走 percent-encoding 且 worktree session 會存在
# 另一個 cwd 底下）。
session_files() {
  case "$1" in
    claude) printf '%s\n' "$HOME"/.claude/projects/*/"$2".jsonl ;;
    grok) printf '%s\n' "$HOME"/.grok/sessions/*/"$2"/updates.jsonl ;;
  esac
}
subagent_files() {
  [ "$1" = claude ] && printf '%s\n' "$HOME"/.claude/projects/*/"$2"/subagents/*.jsonl
  return 0
}
# 主 session 檔與 subagent 檔各掃一次，輸出 "main_epoch sub_epoch"（沒有的用 - 佔位）；
# 呼叫端自己取最大值當活動時間，subagent 那個另外拿去做標記，不重複掃檔
session_epochs() {
  local main="" sub=""
  if [ -n "$2" ]; then
    main=$(session_files "$1" "$2" | epoch_of_file_list)
    sub=$(subagent_files "$1" "$2" | epoch_of_file_list)
  fi
  printf '%s %s' "${main:--}" "${sub:--}"
}
max_epoch() {
  local best="" e
  for e; do
    [ "$e" != - ] || continue
    if [ -z "$best" ] || [ "$e" -gt "$best" ]; then best=$e; fi
  done
  printf '%s' "$best"
}

# 秒數轉成 3d2h / 4h05m / 12m 這種短格式
fmt_age() {
  local s=$1
  if [ "$s" -ge 86400 ]; then printf '%dd%dh' $((s / 86400)) $((s % 86400 / 3600))
  elif [ "$s" -ge 3600 ]; then printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
  else printf '%dm' $((s / 60)); fi
}

# ps 的 etime（[[dd-]hh:]mm:ss）轉秒
etime_to_secs() {
  local e=$1 d=0 h=0 m s
  case "$e" in *-*) d=${e%%-*}; e=${e#*-} ;; esac
  case "$e" in *:*:*) h=${e%%:*}; e=${e#*:} ;; esac
  m=${e%%:*}; s=${e#*:}
  echo $((10#$d * 86400 + 10#$h * 3600 + 10#$m * 60 + 10#$s))
}

# 挑選時的風險標記，逗號串接；沒有就輸出 -
# 參數：session etime desc_count now activity_epoch sub_epoch（後兩個沒有時給 -）
risk_markers() {
  local session=$1 etime=$2 desc_count=$3 now=$4 activity=$5 sub_epoch=$6 out=""
  [ "$desc_count" -gt 0 ] && out="$out,$(t mark_children "$desc_count")"
  if [ "$sub_epoch" != - ] && [ $((now - sub_epoch)) -lt "$SUBAGENT_ACTIVE_WINDOW" ]; then
    out="$out,$(t mark_subagent)"
  fi
  [ "$(etime_to_secs "$etime")" -lt "$JUST_STARTED_WINDOW" ] && out="$out,$(t mark_just_started)"
  [ -n "$session" ] && [ "$activity" = - ] && out="$out,$(t mark_no_transcript)"
  printf '%s' "${out:+${out#,}}"
  [ -n "$out" ] || printf '%s' -
}

# 從 ps 的 args 取出復原時要重播的旗標。去掉 argv0、所有指定或接續 session 的
# 旗標（復原時另外接 --resume <session>）以及裸位置參數（多半是啟動時的
# prompt，重播會被當成新訊息送出）；其餘旗標與其值原樣保留。
# 值是否屬於前一個旗標用「前一個旗標不是已知布林旗標」判斷；ps 看不到原本的
# 引號，含空白的值拆成多個 token 後只會留第一個，這是已知限制。
BOOLEAN_FLAGS=' --dangerously-skip-permissions --allow-dangerously-skip-permissions
 --ax-screen-reader --bg --background --bare --brief --chrome --no-chrome
 --disable-slash-commands --exclude-dynamic-system-prompt-sections
 --forward-subagent-text --ide --include-hook-events --include-partial-messages
 --no-session-persistence --replay-user-messages --restricted --safe-mode
 --strict-mcp-config --tmux --verbose --always-approve --debug --disable-web-search
 --fullscreen --minimal --no-alt-screen --no-plan --no-subagents --oauth
 --restore-code --verbatim '
# 清單以空白或換行分隔，行尾的旗標後面接的是換行，比對要吃兩種
is_boolean_flag() { case "$BOOLEAN_FLAGS" in *[[:space:]]"$1"[[:space:]]*) return 0 ;; esac; return 1; }

# 暫時關掉 globbing 做字串切 token，結束後還原呼叫端原本的設定
glob_off() { case $- in *f*) GLOB_WAS_OFF=1 ;; *) GLOB_WAS_OFF=0 ;; esac; set -f; }
glob_restore() { [ "$GLOB_WAS_OFF" -eq 1 ] || set +f; }

replay_flags() {
  local out="" tok prev_takes_value=0
  glob_off
  # shellcheck disable=SC2086
  set -- $1
  glob_restore
  [ $# -gt 0 ] && shift
  while [ $# -gt 0 ]; do
    tok=$1; shift
    case "$tok" in
      -r|--resume|-s|--session-id|--teleport|--from-pr)
        prev_takes_value=0
        # 值不以 - 開頭就一併丟掉（-r、--teleport、--from-pr 的值可省略）
        if [ $# -gt 0 ]; then case "$1" in -*) ;; *) shift ;; esac; fi ;;
      --resume=*|--session-id=*|--teleport=*|--from-pr=*|-c|--continue|--fork-session)
        prev_takes_value=0 ;;
      -*)
        out="$out $tok"
        if is_boolean_flag "$tok" || [ "${tok#*=}" != "$tok" ]; then
          prev_takes_value=0
        else
          prev_takes_value=1
        fi ;;
      *)
        [ "$prev_takes_value" -eq 1 ] && out="$out $tok"
        prev_takes_value=0 ;;
    esac
  done
  printf '%s' "${out# }"
}

# 一筆復原紀錄：pane kind name session cwd argv（argv 是 replay_flags 的輸出，
# 舊紀錄沒有這欄，讀回來時是空字串）
# 空欄一律寫 -：bash 的 IFS=tab read 會把連續 tab 合併，中間有空欄整列就位移
record_line() {
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "${1:--}" "${2:--}" "${3:--}" "${4:--}" "${5:--}" "${6:--}"
}
undash() { [ "$1" = - ] || printf '%s' "$1"; }

# 狀態檔鎖：macOS 沒有 flock，用 mkdir 的原子性。nap 與 --restore 可能同時跑
# （plugin 兩個 overlay），沒有鎖會互相蓋掉整個檔。60 秒沒動的鎖視為殘留。
LOCK_DIR="$STATE_DIR/.lock"
LOCK_WAIT_SECS=30
HOLDING_LOCK=0
acquire_state_lock() {
  local waited=0
  mkdir -p "$STATE_DIR"
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    if [ -d "$LOCK_DIR" ] && [ -n "$(find "$LOCK_DIR" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then
      rmdir "$LOCK_DIR" 2>/dev/null; continue
    fi
    [ "$waited" -lt "$LOCK_WAIT_SECS" ] || return 1
    sleep 1; waited=$((waited + 1))
  done
  HOLDING_LOCK=1
}
release_state_lock() { [ "$HOLDING_LOCK" -eq 1 ] && { rmdir "$LOCK_DIR" 2>/dev/null; HOLDING_LOCK=0; }; return 0; }

# 逐筆寫入：同 pane 以本次為準，其餘保留。每睡掉一個就立刻落地，後面任何一步
# 失敗都不會弄丟已經退出的 session id
upsert_record() {
  local pane=$1 line=$2
  acquire_state_lock || { echo "$(t lock_busy "$RESTORE_LOG" "$LOCK_WAIT_SECS")" >&2; return 1; }
  { [ -s "$RESTORE_LOG" ] && awk -F'\t' -v p="$pane" '$1 != p' "$RESTORE_LOG"; printf '%s\n' "$line"; } > "$RESTORE_LOG.tmp"
  mv "$RESTORE_LOG.tmp" "$RESTORE_LOG"
  release_state_lock
}
# 刪掉指定 pane 的紀錄（空白分隔的 pane 清單）。只刪這些，其他人在這期間新寫的列保留
remove_records() {
  [ -n "$1" ] && [ -s "$RESTORE_LOG" ] || return 0
  acquire_state_lock || { echo "$(t lock_busy "$RESTORE_LOG" "$LOCK_WAIT_SECS")" >&2; return 1; }
  awk -F'\t' -v list=" $1 " 'index(list, " " $1 " ") == 0' "$RESTORE_LOG" > "$RESTORE_LOG.tmp"
  mv "$RESTORE_LOG.tmp" "$RESTORE_LOG"
  release_state_lock
}

# 手動復原指令，給提示訊息與 stub 用
restore_hint() {
  local pane=$1 kind=$2 name=$3 session=$4 argv=$5
  printf 'herdr agent start %s --kind %s --pane %s -- %s--resume %s' \
    "$name" "$kind" "$pane" "${argv:+$argv }" "$session"
}

pane_exists() { herdr pane process-info --pane "$1" >/dev/null 2>&1; }

# pane 的前景 process：輸出 "pid argv0"
pane_foreground() {
  herdr pane process-info --pane "$1" 2>/dev/null |
    jq -r '.result.process_info.foreground_processes[0] | select(. != null) | "\(.pid) \(.argv0 // .name // "")"'
}

# 從 pane shell 的 pid 反查 pane id（只在少數未辨識的 process 上用，一個一個問）
pane_of_shell_pid() {
  local pane
  while IFS= read -r pane; do
    [ "$(pane_shell_pid "$pane")" = "$1" ] && { printf '%s' "$pane"; return 0; }
  done < <(herdr pane list 2>/dev/null | jq -r '.result.panes[].pane_id')
  return 0
}

pane_agent_status() {
  herdr agent list 2>/dev/null | jq -r --arg p "$1" \
    '.result.agents[] | select(.pane_id == $p) | .agent_status // ""'
}

# 復原後等 herdr 回報 session。沒等到時分兩種：agent 起來了但停在確認畫面
# （實測 claude --resume 會跳工作區信任確認，herdr 回報 blocked），或真的沒起來。
# 輸出 0 = 回來了、1 = 卡在確認畫面、2 = 沒起來
resume_outcome() {
  local pane=$1 session=$2
  wait_for_session "$pane" "$session" && return 0
  [ "$(pane_agent_status "$pane")" = blocked ] && return 1
  return 2
}
blocked_hint() {
  echo "$(t blocked_hint "$1" "$2")"
}

# argv 逐 token 切開重播，關掉 globbing 以免 --add-dir * 這種值被展開成檔名。
# 只輸出 herdr 的回應，不以退出碼論成敗：agent 啟動時卡在確認畫面，herdr 會
# 立刻回 agent_not_ready（非零），但 process 其實已經起來了，成敗交給 resume_outcome 判斷。
start_agent_with_argv() {
  local name=$1 kind=$2 pane=$3 argv=$4 session=$5
  glob_off
  # shellcheck disable=SC2086
  set -- $argv
  glob_restore
  herdr agent start "$name" --kind "$kind" --pane "$pane" -- "$@" --resume "$session" 2>&1 || true
}

stub_path() { echo "$STUB_DIR/$(printf '%s' "$1" | tr -c 'A-Za-z0-9' '_').sh"; }

# 待命中的 stub 同樣是 pane shell 的直屬子 process
stub_pid_of_pane() {
  local shell_pid path
  shell_pid=$(pane_shell_pid "$1"); path=$(stub_path "$1")
  [ -n "$shell_pid" ] || return 0
  awk -v s="$shell_pid" -v p="$path" '$2 == s && index($0, p) { print $1; exit }' "$PS_DUMP"
}

# pane 停在互動 shell 上：前景 process 就是 pane shell 本身
pane_at_prompt() {
  herdr pane process-info --pane "$1" 2>/dev/null | jq -e \
    '.result.process_info | .shell_pid == .foreground_processes[0].pid' >/dev/null
}

# pane 上現在跑的是哪個 session。判斷「紀錄裡那個 session 是否已經回來」只能
# 靠這個：process 存在只證明同 kind 有東西在跑，可能是完全不同的 session。
running_session_of_pane() {
  herdr agent list 2>/dev/null | jq -r --arg p "$1" \
    '.result.agents[] | select(.pane_id == $p) | .agent_session.value // ""'
}

# 等 herdr 回報指定 session 出現在該 pane（agent 起來到被偵測有數秒落差）
wait_for_session() {
  local pane=$1 session=$2 tries=${3:-12} i=0
  while [ "$i" -lt "$tries" ]; do
    [ "$(running_session_of_pane "$pane")" = "$session" ] && return 0
    sleep 1; i=$((i + 1))
  done
  return 1
}

# 包成單引號字串。bash 3.2 的 printf %q 會把中文逐位元組轉成八進位跳脫，
# 產出的 stub 雖然還能執行，但完全不可讀，所以自己包。
sq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# 在 pane 裡留一個待命 stub：顯示橫幅、按 Enter 就地 resume。
# stub 必須是 pane shell 的子 process，內部再 exec 成 agent，agent 才會落在
# 「pane shell 的直屬子 process」這個位置；若讓 stub 取代 pane shell，resume
# 出來的 agent 就是 pane shell 本身，下次清理會把整個 pane 一起收掉。
write_and_arm_stub() {
  local pane=$1 kind=$2 name=$3 session=$4 cwd=$5 freed=$6 argv=$7 title=$8
  local path tmp q_hint q_cwd q_session q_banner q_sub q_title q_bye q_resuming q_fail q_argv="" tok
  path=$(stub_path "$pane"); tmp="$path.tmp"
  [ -n "$cwd" ] || cwd=$HOME
  # 待命時把終端標題設成「[nap] 原標題」，側欄一眼看出睡著的是誰。用 OSC 跳脫
  # 序列不用 herdr tab rename：agent 復原後自己會蓋掉標題，回到 shell 時 prompt
  # 也會重設，不需要任何清理，herdr 重啟 stub 消失時標題也跟著消失。
  q_title=$(sq "[nap] ${title:-$kind}")
  q_hint=$(sq "$(restore_hint "$pane" "$kind" "$name" "$session" "$argv")")
  # 重播的旗標逐個包單引號，寫進 stub 後不會被 glob 或再次展開
  glob_off; for tok in $argv; do q_argv="$q_argv $(sq "$tok")"; done; glob_restore
  q_cwd=$(sq "$cwd")
  q_session=$(sq "$session")
  q_banner=$(sq "$(t stub_banner "$kind" "$freed")")
  q_sub=$(sq "$(t stub_sub "$session")")
  # stub 的訊息在產生時就依當下語言固定下來
  q_bye=$(sq "$(t stub_bye)")
  q_resuming=$(sq "$(t stub_resuming)")
  q_fail=$(sq "$(t stub_exec_failed "$kind" "$(restore_hint "$pane" "$kind" "$name" "$session" "$argv")")")
  mkdir -p "$STUB_DIR"
  cat > "$tmp" <<EOF
#!/bin/bash
# herdr-nap stub：pane ${pane}
# 自動產生。刪掉只會讓這個 pane 少了按 Enter 復原的捷徑，紀錄仍在 napped.tsv。
shopt -s execfail
_bye() {
  stty sane 2>/dev/null || true
  printf '\n\033[2m%s\033[0m\n  %s\n\n' ${q_bye} ${q_hint}
  exit 0
}
trap _bye INT
stty sane 2>/dev/null || true
cd ${q_cwd} 2>/dev/null || cd "\$HOME" || exit 0
printf '\033]0;%s\007' ${q_title}
printf '\n\033[1;35m%s\033[0m\n' ${q_banner}
printf '\033[2m%s\033[0m\n\n' ${q_sub}
IFS= read -r _ || exit 0
printf '%s\n' ${q_resuming}
exec ${kind}${q_argv} --resume ${q_session}
printf '%s\n' ${q_fail}
EOF
  chmod +x "$tmp" && mv "$tmp" "$path"
  # 失敗不能讓 set -e 把腳本打死：紀錄已先寫好，這裡只影響按 Enter 的捷徑
  local out
  if ! out=$(herdr pane run "$pane" bash "$path" 2>&1); then
    echo "$(t stub_not_armed "$pane" "$out")"
  fi
}

# 只清掉「紀錄裡那個 session 確實已經回到該 pane」的項目（多半是使用者自己
# 在 pane 裡按了 Enter）。pane 上跑著別的 session 不算復原，紀錄必須留著，
# 否則那個 session id 就永遠找不回來了。
prune_stale_records() {
  [ -s "$RESTORE_LOG" ] || return 0
  local pane kind name session cwd argv stale=""
  while IFS=$'\t' read -r pane kind name session cwd argv; do
    [ -n "$pane" ] || continue
    session=$(undash "$session")
    if [ -n "$session" ] && [ "$(running_session_of_pane "$pane")" = "$session" ]; then
      rm -f "$(stub_path "$pane")"
      stale="$stale $pane"
    fi
  done < "$RESTORE_LOG"
  remove_records "${stale# }"
}

# 以上全是函式。測試只載入函式：HERDR_NAP_LIB_ONLY=1 source herdr-nap
if [ "${HERDR_NAP_LIB_ONLY:-}" = 1 ]; then return 0 2>/dev/null || exit 0; fi

MODE=${1:-}
case "$MODE" in
  ""|--list|--restore) ;;
  *)
    echo "$(t usage)"
    exit 1
    ;;
esac

need "$HERDR_BIN"
need jq
# fzf 只有互動挑選用得到，--list 與 --restore 不該被它擋住
[ -n "$MODE" ] || need fzf

PS_DUMP=$(mktemp "${TMPDIR:-/tmp}/herdr-nap.ps.XXXXXX")
trap 'rm -f "$PS_DUMP"; release_state_lock' EXIT
refresh_ps_dump

# ---------- 復原模式 ----------
if [ "$MODE" = "--restore" ]; then
  prune_stale_records
  if [ ! -s "$RESTORE_LOG" ]; then
    echo "$(t restore_nothing "$RESTORE_LOG")"
    exit 0
  fi
  echo "$(t restore_heading)"
  cut -f1-4 "$RESTORE_LOG" | column -t -s$'\t'
  t restore_confirm
  read -r ans
  [ "$ans" = "y" ] || [ "$ans" = "Y" ] || { echo "$(t cancelled)"; exit 0; }
  ok=0; fail=0; restored_panes=""
  # 紀錄留在檔案裡直到確定復原成功；keep_record 只是讓各分支語意清楚
  keep_record() { :; }
  while IFS=$'\t' read -r pane kind name session cwd argv; do
    [ -n "$pane" ] || continue
    name=$(undash "$name"); session=$(undash "$session"); cwd=$(undash "$cwd"); argv=$(undash "$argv")
    if [ -z "$session" ]; then
      echo "$(t bad_record "$pane")"
      keep_record "$pane" "$kind" "$name" "$session" "$cwd" "$argv"
      fail=$((fail + 1))
      continue
    fi
    hint=$(restore_hint "$pane" "$kind" "$name" "$session" "$argv")
    if ! pane_exists "$pane"; then
      # pane 已被關掉（或 workspace 整個沒了）。session id 只存在紀錄裡，
      # 保留紀錄，請使用者挑一個空 pane 復原。
      echo "$(t pane_gone "$pane")"
      echo "$(t pane_gone_hint "${hint/--pane $pane/--pane <pane>}")"
      keep_record "$pane" "$kind" "$name" "$session" "$cwd" "$argv"
      fail=$((fail + 1))
      continue
    fi
    running=$(running_session_of_pane "$pane")
    if [ "$running" = "$session" ]; then
      echo "$(t already_running "$pane" "$kind")"
      rm -f "$(stub_path "$pane")"
      ok=$((ok + 1)); restored_panes="$restored_panes $pane"
      continue
    fi
    if [ -n "$running" ]; then
      # pane 被另一個 session 佔用。這筆的 session id 只存在紀錄裡，丟了就
      # 再也拉不回來，所以保留讓使用者自己決定要不要換 pane 復原。
      echo "$(t other_session "$pane" "$running")"
      echo "$(t other_session_hint "${hint/--pane $pane/--pane <pane>}")"
      keep_record "$pane" "$kind" "$name" "$session" "$cwd" "$argv"
      fail=$((fail + 1))
      continue
    fi
    refresh_ps_dump
    stub_pid=$(stub_pid_of_pane "$pane")
    if [ -n "$stub_pid" ]; then
      # stub 待命中：pane 不在 shell prompt 上，agent start 會被拒絕，
      # 送 Enter 讓 stub 自己 exec 成 agent
      herdr pane send-keys "$pane" enter >/dev/null 2>&1 || true
      resume_outcome "$pane" "$session" && rc=0 || rc=$?
      case "$rc" in
        0) echo "$(t restored_stub "$pane" "$kind")"
           rm -f "$(stub_path "$pane")"; ok=$((ok + 1)); restored_panes="$restored_panes $pane" ;;
        1) blocked_hint "$pane" "$kind"
           keep_record "$pane" "$kind" "$name" "$session" "$cwd" "$argv"; fail=$((fail + 1)) ;;
        *) echo "$(t stub_not_up "$pane" "$kind")"
           keep_record "$pane" "$kind" "$name" "$session" "$cwd" "$argv"; fail=$((fail + 1)) ;;
      esac
    elif ! pane_at_prompt "$pane"; then
      echo "$(t fg_busy "$pane")"
      keep_record "$pane" "$kind" "$name" "$session" "$cwd" "$argv"
      fail=$((fail + 1))
    else
      out=$(start_agent_with_argv "$name" "$kind" "$pane" "$argv" "$session")
      resume_outcome "$pane" "$session" && rc=0 || rc=$?
      case "$rc" in
        0) echo "$(t restored_start "$pane" "$kind" "${argv:+$argv }--resume $session")"
           rm -f "$(stub_path "$pane")"; ok=$((ok + 1)); restored_panes="$restored_panes $pane" ;;
        1) blocked_hint "$pane" "$kind"
           keep_record "$pane" "$kind" "$name" "$session" "$cwd" "$argv"; fail=$((fail + 1)) ;;
        *) echo "$(t restore_failed "$pane" "$kind" "$out")"
           echo "$(t manual_hint "$hint")"
           keep_record "$pane" "$kind" "$name" "$session" "$cwd" "$argv"; fail=$((fail + 1)) ;;
      esac
    fi
  done < <(cat "$RESTORE_LOG")
  remove_records "${restored_panes# }"
  echo "$(t restore_done "$ok" "$fail")"
  exit 0
fi

# ---------- 收集候選 ----------
# --list 是唯讀模式，不動狀態檔
[ "$MODE" = "--list" ] || prune_stale_records

# 自身排除：herdr 列比對所在 pane；proc 列走祖先 PID（在 herdr 之外執行時
# pane current 拿不到，祖先鏈也是 herdr 列的後備）
self_pane=$(herdr pane current 2>/dev/null | jq -r '.result.pane.pane_id // empty')
ancestors=""
p=$$
while [ "$p" -gt 1 ]; do
  ancestors="$ancestors $p"
  p=$(awk -v x="$p" '$1 == x { print $2; exit }' "$PS_DUMP")
  [ -n "$p" ] || break
done
is_ancestor() { case " $ancestors " in *" $1 "*) return 0 ;; esac; return 1; }

rows=()
herdr_pids=""
pinned_panes=""
now=$(date +%s)
patterns=$(exclude_patterns "$EXCLUDE_FILE")
# tab 標籤（side bar 顯示的名字）一次拉齊，釘選比對要用
tab_labels=$(herdr tab list 2>/dev/null | jq -r '.result.tabs[] | [.tab_id, .label // ""] | @tsv')
while IFS=$'\t' read -r kind pane tab status name session cwd title; do
  [ "$pane" = "$self_pane" ] && continue
  label=$(printf '%s\n' "$tab_labels" | awk -F'\t' -v t="$tab" '$1 == t { print $2; exit }')
  pinned=0
  if is_pinned "$patterns" "$title" "$label"; then pinned=1; pinned_panes="$pinned_panes $pane"; fi
  read -r pid _rss etime args <<< "$(agent_row_of_pane "$pane" "$kind")"
  [ -n "${pid:-}" ] || continue
  if is_ancestor "$pid"; then continue; fi
  herdr_pids="$herdr_pids $pid"
  [ -n "$name" ] || name=$kind
  read -r rss desc_count <<< "$(tree_rss_of_pid "$pid")"
  # 閒置 = 對話紀錄最後一筆到現在；沒有紀錄就退回 process 年齡
  read -r main_epoch sub_epoch <<< "$(session_epochs "$kind" "$session")"
  activity=$(max_epoch "$main_epoch" "$sub_epoch")
  if [ -n "$activity" ]; then idle_secs=$((now - activity)); else idle_secs=$(etime_to_secs "$etime"); fi
  [ "$idle_secs" -ge 0 ] || idle_secs=0
  risk=$(risk_markers "$session" "$etime" "$desc_count" "$now" "${activity:--}" "$sub_epoch")
  if [ "$pinned" -eq 1 ]; then risk="$(t mark_pinned)${risk:+,$risk}"; risk=${risk%,-}; fi
  rows+=("$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s' \
    herdr "$kind" "$pane" "$status" "$pid" "$((rss / 1024))MB" "$(fmt_age "$idle_secs")" \
    "$risk" "${cwd/#$HOME/~}" "$title" "$etime" "$name" "$session" "$(replay_flags "$args")" \
    "$idle_secs" "$pinned")")
done < <(herdr agent list | jq -r '.result.agents[] |
  [.agent, .pane_id, .tab_id // "", .agent_status, .name // .agent, .agent_session.value // "",
   .cwd, .terminal_title_stripped] | @tsv')

# herdr 之外直開的 claude / grok（同一份 ps 快照，不再掃一次）
while read -r pid _ppid rss etime args; do
  # 只比對 argv0：args 全文比對會被指令參數裡的文字（例如送給 agent 的訊息）誤觸
  argv0=${args%% *}; argv0=${argv0##*/}
  case "$argv0" in claude|grok) kind=$argv0 ;; *) continue ;; esac
  if is_ancestor "$pid"; then continue; fi
  case " $herdr_pids " in *" $pid "*) continue ;; esac
  cwd=$(lsof -a -p "$pid" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)
  read -r rss _desc_count <<< "$(tree_rss_of_pid "$pid")"
  # 在 herdr pane 裡但 herdr 沒辨識成 agent（resume 卡在確認畫面、偵測延遲）：
  # 照樣列出讓人看得到，但來源標 herdr?，勾了也不動它；找得到 pane 就標 pane
  if inside_herdr_tree "$pid"; then
    src="herdr?"; pane=$(pane_of_shell_pid "$_ppid"); risk=$(t mark_unregistered)
  else
    src=proc; pane=-; risk=-
  fi
  # 散裝 process 沒有 session id 可查閒置，排序鍵給 -1 沉到最底
  rows+=("$(printf '%s\t%s\t%s\t-\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t-\t-\t-\t-1\t0' \
    "$src" "$kind" "${pane:--}" "$pid" "$((rss / 1024))MB" "$(fmt_age "$(etime_to_secs "$etime")")" \
    "$risk" "${cwd/#$HOME/~}" "$(echo "$args" | cut -c1-50)" "$etime")")
done < "$PS_DUMP"

# 遠端連線的 pane（前景是 ssh / mosh）：agent 在另一台機器上，本機看不到也動不了，
# 列出來只是讓清單完整，來源標 remote，勾了只提示
while IFS=$'\t' read -r pane cwd title; do
  [ "$pane" = "$self_pane" ] && continue
  read -r fg_pid fg_cmd <<< "$(pane_foreground "$pane")"
  case "${fg_cmd##*/}" in ssh|mosh|mosh-client) ;; *) continue ;; esac
  etime=$(awk -v x="$fg_pid" '$1 == x { print $4; exit }' "$PS_DUMP")
  rows+=("$(printf '%s\t%s\t%s\t-\t%s\t-\t%s\t%s\t%s\t%s\t%s\t-\t-\t-\t-1\t0' \
    remote "${fg_cmd##*/}" "$pane" "$fg_pid" "$(fmt_age "$(etime_to_secs "${etime:-00:00}")")" \
    "$(t mark_remote)" "${cwd/#$HOME/~}" "$title" "${etime:-00:00}")")
done < <(herdr pane list 2>/dev/null | jq -r '.result.panes[] | select(.agent == null) |
  [.pane_id, .cwd, .terminal_title_stripped // ""] | @tsv')

if [ "${#rows[@]}" -eq 0 ]; then
  echo "$(t no_agents "")"
  exit 0
fi

header_row="$(t header_row)"$'\tUPTIME\tNAME\tSESSION\tARGV\tIDLE_SECS\tPINNED'
# 閒置最久的排最上面，同秒數再依 pane 排，順序才穩定；RSS 是整棵 process 樹的合計
sorted_rows=$(printf '%s\n' "${rows[@]}" | sort -t$'\t' -k"$IDLE_SORT_FIELD","$IDLE_SORT_FIELD"nr -k3,3)
if [ "$MODE" = "--list" ]; then
  { echo "$header_row"; printf '%s\n' "$sorted_rows"; } | cut -f"$FIELDS_SHOWN" | fill_empty_fields |
    column -t -s$'\t' | dim_pinned_lines "$pinned_panes"
  exit 0
fi

# 釘選的 pane 不進挑選清單，連誤點的機會都不給
candidate_rows=$(printf '%s\n' "$sorted_rows" | awk -F'\t' -v f="$PINNED_FIELD" '$f != 1')
pinned_note=""
[ -z "$pinned_panes" ] || pinned_note=$(t pinned_note "${pinned_panes# }" "${EXCLUDE_FILE/#$HOME/~}")
if [ -z "$candidate_rows" ]; then
  echo "$(t no_agents "$pinned_note")"
  exit 0
fi

# 預覽窗顯示游標所在 pane 的目前畫面，勾選前先看得到它在做什麼。
# {3} 是 PANE 欄；fzf 依 delimiter 切欄位時可能帶著尾端的 tab，先清掉空白。
preview_cmd='p=$(printf %s {3} | tr -d "[:space:]")
case "$p" in
  w*:p*) '"$(sq "$HERDR_BIN")"' pane read --source visible "$p" 2>/dev/null || echo '"$(sq "$(t preview_unreadable)")"' ;;
  *) echo '"$(sq "$(t preview_none)")"' ;;
esac'
selected=$({ echo "$header_row"; printf '%s\n' "$candidate_rows"; } | fzf --multi --reverse \
  --delimiter=$'\t' --with-nth="$FIELDS_SHOWN" --header-lines=1 \
  --preview="$preview_cmd" --preview-window='down,50%,follow' --bind='ctrl-/:toggle-preview' \
  --header="$(t fzf_header "$pinned_note")") || {
  echo "$(t fzf_cancel)"
  exit 0
}

echo "$selected" | cut -f"$FIELDS_SHOWN" | fill_empty_fields | column -t -s$'\t'
t nap_confirm "$(echo "$selected" | wc -l | tr -d ' ')"
read -r ans
[ "$ans" != "y" ] && [ "$ans" != "Y" ] && { echo "$(t cancelled)"; exit 0; }

napped=0
sig_pids=""
# 使用者在 fzf 裡可能停很久，清單是舊快照：動手前重拍 ps、逐筆重核對
refresh_ps_dump
while IFS=$'\t' read -r src kind pane _status pid rss _idle _risk cwd title _etime name session argv _idle_secs _pinned; do
  if [ "$src" = "herdr" ]; then
    # /exit 是對 pane 送的：pane 上的 session 若已換人，送下去會請走別人
    running=$(running_session_of_pane "$pane")
    if [ "$running" != "$session" ]; then
      echo "$(t skip_changed "$pane" "session ${running:-none}")"
      continue
    fi
    # agent_not_running 代表 /exit 已生效、wait 撲空，視為成功
    out=$(herdr agent prompt "$pane" "/exit" --wait --until unknown --timeout 20000 2>&1) || true
    sleep 1
    refresh_ps_dump
    if [ -n "$(agent_pid_of_pane "$pane" "$kind")" ]; then
      echo "$(t not_exited "$pane" "$kind" "$out")"
    elif [ -z "$session" ]; then
      # 沒有 session id 就沒有復原路徑，不留紀錄也不留 stub，明講後果
      echo "$(t no_session "$pane" "$kind")"
    else
      cwd="${cwd/#\~/$HOME}"
      # 先落地紀錄，再種 stub：stub 失敗頂多少了按 Enter 的捷徑，session id 不會丟
      upsert_record "$pane" "$(record_line "$pane" "$kind" "$name" "$session" "$cwd" "$argv")" || true
      write_and_arm_stub "$pane" "$kind" "$name" "$session" "$cwd" "$rss" "$argv" "$title"
      echo "$(t napped "$pane" "$kind" "${argv:+$(t napped_argv "$argv")}")"
      napped=$((napped + 1))
    fi
  elif [ "$src" = "herdr?" ]; then
    echo "$(t skip_unregistered "${pane}${pane:+ }PID $pid")"
  elif [ "$src" = "remote" ]; then
    echo "$(t skip_remote "$pane" "$title")"
  else
    # PID 可能已被回收給別的 process，或 herdr CLI 剛才失靈把 pane 內的 agent 誤歸到這裡
    now_argv0=$(awk -v x="$pid" '$1 == x { a = $5; sub(/^.*\//, "", a); print a; exit }' "$PS_DUMP")
    if [ "$now_argv0" != "$kind" ] || inside_herdr_tree "$pid"; then
      echo "$(t skip_changed "PID $pid" "${now_argv0:-gone}")"
      continue
    fi
    sig_pids="$sig_pids $pid"
    kill "$pid" 2>/dev/null || true
  fi
done <<< "$selected"

if [ -n "$sig_pids" ]; then
  sleep 2
  refresh_ps_dump
  for pid in $sig_pids; do
    if awk -v x="$pid" '$1 == x { found = 1 } END { exit !found }' "$PS_DUMP"; then
      echo "$(t pid_alive "$pid" "$pid")"
    else
      echo "$(t pid_killed "$pid")"
    fi
  done
fi

[ "$napped" -eq 0 ] || echo "$(t restore_howto)"
