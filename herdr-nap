    skip_unregistered) printf '%%s 在 herdr pane 裡但 herdr 沒辨識成 agent（resume 卡住或偵測延遲），工具不動它；到該 pane 查看，或稍後重跑。' ;;
    skip_remote) printf '%%s 是遠端連線（%%s），agent 在另一台機器上，請到那台跑 herdr-nap。' ;;
    header_row) printf '來源\tAGENT\tPANE\t狀態\tPID\tRSS\t閒置\t備註\tCWD\t標題 / 指令' ;;
    pinned_note) printf '釘選排除：%%s（改 %%s）。' ;;
    preview_unreadable) printf '讀不到這個 pane 的畫面' ;;
    preview_none) printf 'herdr 之外的 process，沒有 pane 畫面' ;;
    fzf_header) printf 'TAB 勾選多個、Enter 清理所選、Esc 取消。閒置最久的排最上面；working 與備註有標記的還在做事，勾選前想清楚。\nherdr 列走 /exit，pane 留 stub 按 Enter 可復原；proc 列是 SIGTERM，要自己 claude --resume\n下方預覽窗是游標所在 pane 的目前畫面，Ctrl-/ 切換顯示。%%s' ;;
    fzf_cancel) printf '取消，未清理任何 agent。' ;;
    nap_confirm) printf '清理以上 %%s 個 agent？[y/N] ' ;;
    not_exited) printf '%%s %%s 未退出，herdr 回應：%%s' ;;
    no_session) printf '%%s %%s 已退出，但 herdr 沒有回報 session id，這個對話無法自動復原。' ;;
    napped) printf '%%s %%s 已休眠（pane 保留，按 Enter 即可復原%%s）' ;;
    napped_argv) printf '，復原時帶回 %%s' ;;
    pid_alive) printf 'PID %%s 未退出（可自行 kill -9 %%s）' ;;
    pid_killed) printf 'PID %%s 已終止（可用 claude --resume 或 grok --resume 復原）' ;;
    restore_howto) printf '復原方式：到該 pane 按 Enter，或整批跑 herdr-nap --restore' ;;
    *) printf '%s' "$1" ;;
  esac
}

